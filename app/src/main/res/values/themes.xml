<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zvpn" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_lime</item>
        <item name="colorOnPrimary">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Brand" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_lime</item>
        <item name="colorOnPrimary">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Brand.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_lime</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Brand</item>
    </style>
</resources>
